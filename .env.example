# Copy to .env next to docker-compose.yml (compose reads it) and adjust.
# For running the backend directly on the host, copy to backend/.env instead and use localhost URLs
# (see "Local development" in the README).

ENV=dev
LOG_JSON=true

# --- Security (MUST change outside local dev) ---
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-too
FRONTEND_URL=http://localhost:8080

# --- LLM (local Ollama on the host) ---
# NOTE: this is OLLAMA_URL, not OLLAMA_HOST (OLLAMA_HOST is Ollama's own server bind address).
LLM_PROVIDER=ollama            # ollama | fake (deterministic heuristics, no LLM)
OLLAMA_URL=http://host.docker.internal:11434
LLM_MODEL_CLASSIFY=llama3.2:latest
LLM_MODEL_REASON=llama3.2:latest   # qwen2.5:7b-instruct gives noticeably better analysis if you have the RAM
EMBED_MODEL=nomic-embed-text       # 768-dim; must match the vector column

# --- Monitoring ---
# Allow sources on private/loopback addresses (needed for the local demo sites; keep false in production).
ALLOW_PRIVATE_SOURCES=true

# --- Optional SSO (OpenID Connect). Users must already exist in MarketRadar. ---
OIDC_ENABLED=false
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

# --- Optional OpenTelemetry collector (OTLP/HTTP) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
